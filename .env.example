# Copy to .env for local testing. In the cloud these are set as environment
# variables on the routine's environment, NOT committed here.

# tastytrade OAuth app: my.tastytrade.com -> Manage -> API Access -> OAuth
TASTY_CLIENT_SECRET=
TASTY_REFRESH_TOKEN=

# Alpaca (free paper account) -> news API
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Finnhub free tier -> earnings calendar
FINNHUB_API_KEY=

# Supabase project settings -> API
SUPABASE_URL=
SUPABASE_KEY=

# Telegram bot from @BotFather, chat id from getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
